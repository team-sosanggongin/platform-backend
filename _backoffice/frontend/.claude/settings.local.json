      "Bash(powershell -Command \"Move-Item ''app/\\(main\\)/users'' ''app/\\(main\\)/backoffice/users''; Move-Item ''app/\\(main\\)/notices'' ''app/\\(main\\)/backoffice/notices''; Move-Item ''app/\\(main\\)/roles'' ''app/\\(main\\)/backoffice/roles''; Write-Host ''done''\")"
